---
import "@fontsource-variable/geist";
import LanguagePicker from "../components/LanguagePicker.astro";
import LiquidNav from "../components/LiquidNav.astro";
import OrbitalLoader from "../components/OrbitalLoader.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { base, translate, type Language } from "../i18n";
import "../styles/site.css";
import "../styles/orbit.css";
import "../styles/arcade.css";

interface Props {
  lang: Language;
  articleTitle?: string;
  hideLoader?: boolean;
  hideFooter?: boolean;
}
const { lang, hideLoader = false, hideFooter = false } = Astro.props;
const isArticle = Boolean(Astro.props.articleTitle);
const home = isArticle ? base : "";
const es = lang === "es";
const t = translate(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      try {
        const game = sessionStorage.getItem("orbital-arcade");
        if (
          [
            "mk",
            "doom",
            "sonic",
            "tetris",
            "pacman",
            "sf2",
            "cs16",
            "halflife",
            "quake",
            "invaders",
            "asteroids",
            "pong",
            "metalslug",
            "gtasa",
            "portal",
            "halo",
          ].includes(game)
        ) {
          document.documentElement.dataset.arcade = game;
        }
      } catch { /* Storage can be unavailable in private browsing. */ }
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.dataset.boot = "skip";
      }
    </script>
    <noscript><style>.orbital-loader{display:none!important}</style></noscript>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t("aboutP1")} />
    <meta name="theme-color" content="#030817" />
    <title>{Astro.props.articleTitle || "Ezequiel Morales"} · ForcexDev</title>
    <link rel="icon" href={base + "orbit.svg"} type="image/svg+xml" />
    <link rel="alternate" hreflang="es" href={new URL(base, Astro.site)} />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(base + "en.html", Astro.site)}
    />
  </head>
  <body>
    {!hideLoader && <OrbitalLoader />}
    <div
      class="starfield-wrap"
      aria-hidden="true"
      style={`--star-field:url("${base}media/deep-field.png")`}
    >
      <canvas id="starfield" class="starfield"></canvas>
    </div>
    <a class="skip" href="#main">
      {es ? "Ir al contenido" : "Skip to content"}
    </a>
    <header
      class="mast"
      id="mast"
      data-article={isArticle ? "true" : "false"}
    >
      <span class="mast-bar-bg" aria-hidden="true"></span>
      <div class="mast-shell">
        <span class="mast-pill-bg" aria-hidden="true"></span>
        <div class="mast-row">
          <a
            href={home + "#home"}
            class="brand"
            aria-label="ForcexDev — Inicio"
          >
            <img src={base + "orbit.svg"} width="30" height="30" alt="" />
            <span class="brand-text">Forcex<span>Dev</span></span>
          </a>

          <span class="mast-sep" aria-hidden="true"></span>

          <LiquidNav lang={lang} home={home} isArticle={isArticle} />

          <span class="mast-sep" aria-hidden="true"></span>

          <div class="nav-actions">
            <LanguagePicker lang={lang} />
            <button
              id="menu"
              type="button"
              aria-expanded="false"
              aria-controls="liquid-nav"
              aria-label={es ? "Secciones" : "Sections"}
            >
              {es ? "Secciones" : "Sections"} <Icon name="lucide:chevron-down" />
            </button>
          </div>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <Footer lang={lang} home={home} />}
    <div id="orbital-cursor" class="orbital-cursor" aria-hidden="true">
      <span></span>
    </div>
    <script>
      import { initStarfield } from "../scripts/starfield";
      import { initGlobalLiquidNav } from "../scripts/liquid-nav";
      import { initOrbitalMotion } from "../scripts/orbital-motion";
      initStarfield();
      initGlobalLiquidNav();
      initOrbitalMotion();

      document.addEventListener(
        "pointermove",
        (event) => {
          const element = (event.target as Element)?.closest<HTMLElement>(
            "[data-glow]",
          );
          if (!element) return;
          const bounds = element.getBoundingClientRect();
          element.style.setProperty("--mx", event.clientX - bounds.left + "px");
          element.style.setProperty("--my", event.clientY - bounds.top + "px");
        },
        { passive: true },
      );

      const menu = document.querySelector<HTMLButtonElement>("#menu")!;
      const nav = document.getElementById("liquid-nav")!;
      function toggle(open: boolean) {
        menu.setAttribute("aria-expanded", String(open));
        nav.classList.toggle("open", open);
      }
      menu.addEventListener("click", () =>
        toggle(menu.getAttribute("aria-expanded") === "false"),
      );
      nav.addEventListener("click", () => toggle(false));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && nav.classList.contains("open")) {
          toggle(false);
          menu.focus();
        }
      });
    </script>
  </body>
</html>
