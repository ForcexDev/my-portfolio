---
import { base } from "../i18n";
---

<div id="orbital-loader" class="orbital-loader" aria-hidden="true">
  <div class="loader-core">
    <div class="loader-brand-row">
      <img
        class="loader-mark"
        src={base + "orbit.svg"}
        width="26"
        height="26"
        alt=""
        decoding="sync"
      />
      <span class="loader-wordmark">Forcex<span>Dev</span></span>
    </div>

    <div class="loader-meter">
      <div class="loader-bar" role="presentation">
        <span class="loader-fill" data-loader-fill></span>
      </div>
      <span class="loader-pct" data-loader-pct>00%</span>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const el = document.getElementById("orbital-loader");
    const docEl = document.documentElement;
    if (!el || docEl.dataset.boot === "skip") {
      if (el) el.remove();
      docEl.dataset.boot = "ready";
      return;
    }

    const fillEl = el.querySelector("[data-loader-fill]");
    const pctEl = el.querySelector("[data-loader-pct]");
    const startTime = performance.now();
    let targetPct = 88;
    let displayPct = 0;
    let rafId = 0;

    const tick = (now) => {
      const elapsed = now - startTime;
      const ceiling = targetPct === 100 ? 100 : Math.min(88, Math.round((elapsed / 520) * 88));
      displayPct += (Math.max(ceiling, targetPct === 100 ? 100 : 0) - displayPct) * (targetPct === 100 ? 0.35 : 0.18);
      const shown = Math.min(100, Math.round(displayPct));
      if (fillEl) fillEl.style.transform = `scaleX(${Math.max(0.04, shown / 100)})`;
      if (pctEl) pctEl.textContent = `${String(shown).padStart(2, "0")}%`;
      if (shown < targetPct) {
        rafId = requestAnimationFrame(tick);
      }
    };
    rafId = requestAnimationFrame(tick);

    let earthResolved = false;
    const minWait = new Promise((r) => setTimeout(r, 340));
    const maxCap = new Promise((r) => setTimeout(r, 820));
    const earthReady = new Promise((resolve) => {
      const done = () => {
        if (earthResolved) return;
        earthResolved = true;
        resolve();
      };
      window.addEventListener("orbital:earth-ready", done, { once: true });
      if (document.readyState === "complete") {
        setTimeout(done, 120);
      } else {
        window.addEventListener("load", () => setTimeout(done, 80), { once: true });
      }
    });

    const fontsReady = document.fonts ? document.fonts.ready.catch(() => {}) : Promise.resolve();

    Promise.all([minWait, Promise.race([Promise.all([fontsReady, earthReady]), maxCap])]).then(() => {
      targetPct = 100;
      cancelAnimationFrame(rafId);
      if (fillEl) fillEl.style.transform = "scaleX(1)";
      if (pctEl) pctEl.textContent = "100%";

      requestAnimationFrame(() => {
        setTimeout(() => {
          el.classList.add("leaving");
          docEl.dataset.boot = "ready";
          const cleanup = () => el.remove();
          el.addEventListener("transitionend", cleanup, { once: true });
          setTimeout(cleanup, 480);
        }, 70);
      });
    });
  })();
</script>

<style>
  .orbital-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: #030713;
    opacity: 1;
    transition:
      opacity 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html[data-boot="skip"]) .orbital-loader {
    display: none;
  }

  .orbital-loader.leaving {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
  }

  .loader-core {
    display: grid;
    justify-items: center;
    gap: 20px;
  }

  .loader-brand-row {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }

  .loader-mark {
    width: 26px;
    height: 26px;
    display: block;
  }

  .loader-wordmark {
    font: 600 18px/1 var(--sans);
    letter-spacing: -0.025em;
    color: #f3f8ff;
  }

  .loader-wordmark span {
    color: var(--ice);
  }

  .loader-meter {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .loader-bar {
    position: relative;
    width: 168px;
    height: 1px;
    background: rgba(125, 211, 252, 0.16);
    overflow: hidden;
  }

  .loader-fill {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0.06);
    transform-origin: left center;
    background: linear-gradient(90deg, rgba(125, 211, 252, 0.65), #ffffff);
  }

  .loader-pct {
    min-width: 34px;
    text-align: right;
    font: 500 11.5px/1 var(--mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: #93b8de;
  }
</style>
