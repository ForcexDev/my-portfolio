---
/**
 * Imagen con pie y lupa. Al hacer clic se abre a pantalla completa.
 *
 *   import captura from '@/assets/img/algo.png';
 *   <Figura src={captura} alt="..." pie="Lo que se ve aquí" />
 *
 * `video` sirve para los GIF convertidos a MP4: se reproducen solos, en
 * bucle y sin sonido, y pesan una décima parte que el GIF original.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  pie?: string;
  /** Ruta dentro de public/, sin extensión. Los crea scripts/gif-a-video.mjs */
  video?: string;
  ancho?: 'normal' | 'ancho';
}
const { src, alt = '', pie, video, ancho = 'normal' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class:list={['figura', ancho === 'ancho' && 'figura--ancha']}>
  {
    video ? (
      <video autoplay muted loop playsinline preload="metadata" aria-label={alt}>
        <source src={`${base}/${video}.mp4`} type="video/mp4" />
      </video>
    ) : (
      src && <Image src={src} alt={alt} widths={[640, 960, 1280]} sizes="(max-width: 860px) 92vw, 820px" />
    )
  }
  {pie && <figcaption>{pie}</figcaption>}
</figure>

<style>
  .figura {
    margin: 2rem 0;
  }
  .figura--ancha {
    /* se sale del ancho de lectura hasta donde deje el contenedor */
    margin-inline: clamp(-3rem, -4vw, 0rem);
  }
  .figura :global(img),
  .figura video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(66 153 225 / 0.18);
    border-radius: 12px;
    box-shadow: var(--shadow-cosmic);
  }
  .figura :global(img) {
    cursor: zoom-in;
  }
  figcaption {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-dim);
    opacity: 0.75;
    text-align: center;
  }
</style>
