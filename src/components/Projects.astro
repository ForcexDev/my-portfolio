---
import { Icon } from "astro-icon/components";
import projects from "../data/projects.json";
import { base, translate, type Language } from "../i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const es = lang === "es";
const t = translate(lang);

type ProjectEntry = (typeof projects)[number] & {
  featured?: boolean;
  portfolioUrl?: string;
};
const projectList = projects as ProjectEntry[];

const cover = (p: ProjectEntry) =>
  base + (p.id === 1 ? "media/chess-match.webp" : p.image);

const featuredProjects = projectList.filter((p) => Boolean(p.featured));
const archiveProjects = projectList.filter((p) => !p.featured);

const featuredClass = (index: number) =>
  index === 2 ? "bento-card bento-wide" : "bento-card bento-flagship";
---

<section
  class="section wrap work-section"
  id="projects"
  aria-labelledby="work-heading"
>
  <h2 id="work-heading" data-reveal>{t("projectsTitle")}</h2>

  <div class="bento-grid">
    {featuredProjects.map((p, index) => {
      const hasCase = Boolean(p.portfolioUrl);
      const hasLive = p.liveUrl !== "#";
      const hasGit = Boolean(p.github);
      const primaryHref = hasCase
        ? base + p.portfolioUrl!
        : hasLive
          ? p.liveUrl
          : p.github;
      const isExternalPrimary = !hasCase;
      const mediaCursor = hasCase
        ? es
          ? "Ver caso"
          : "Read case"
        : hasLive
          ? es
            ? "Visitar"
            : "Visit"
          : "GitHub";
      return (
        <article
          class={featuredClass(index)}
          data-glow
          data-reveal
          style={`--rd:${index * 90}ms`}
        >
          <a
            class="bento-media"
            href={primaryHref}
            target={isExternalPrimary ? "_blank" : undefined}
            rel={isExternalPrimary ? "noopener noreferrer" : undefined}
            tabindex="-1"
            aria-hidden="true"
            data-cursor={mediaCursor}
          >
            <img
              src={cover(p)}
              alt=""
              width="800"
              height="450"
              loading={index < 2 ? "eager" : "lazy"}
              decoding="async"
            />
          </a>
          <div class="bento-body">
            <p class="bento-stack">{p.tags.slice(0, 4).join(" · ")}</p>
            <h3>{t(p.titleKey)}</h3>
            <p class="bento-desc">{t(p.descKey)}</p>
            <div class="bento-actions">
              {hasCase ? (
                <a
                  class="bento-primary"
                  href={base + p.portfolioUrl!}
                  data-cursor={es ? "Ver caso" : "Read case"}
                >
                  {es ? "Ver caso" : "Read case"}
                  <Icon name="lucide:arrow-up-right" />
                </a>
              ) : hasLive ? (
                <a
                  class="bento-primary"
                  href={p.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-cursor={es ? "Visitar" : "Visit"}
                >
                  {es ? "Visitar sitio" : "Visit site"}
                  <Icon name="lucide:arrow-up-right" />
                </a>
              ) : null}
              {hasCase && hasLive && (
                <a
                  class="bento-link hover-ul"
                  href={p.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-cursor="Demo"
                >
                  Demo
                  <Icon name="lucide:external-link" />
                </a>
              )}
              {hasGit && (
                <a
                  class={
                    hasCase || hasLive ? "bento-link hover-ul" : "bento-primary"
                  }
                  href={p.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-cursor="GitHub"
                >
                  <Icon name="simple-icons:github" />
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <div class="repo-archive" data-reveal style="--rd:120ms">
    <div class="repo-head">
      <h3>{es ? "Laboratorio y repositorios" : "Lab & repositories"}</h3>
      <span class="repo-count">
        {String(archiveProjects.length).padStart(2, "0")}
      </span>
    </div>

    <div class="repo-th" aria-hidden="true">
      <span>{es ? "Repositorio" : "Repository"}</span>
      <span>{es ? "Enfoque" : "Focus"}</span>
      <span>{es ? "Vista" : "Preview"}</span>
    </div>

    <div class="repo-list" data-archive-list>
      {archiveProjects.map((p, index) => (
        <article
          class="repo-row"
          data-archive-row
          data-active={index === 0 ? "" : undefined}
          data-cursor={p.github?"GitHub":"Web"}
        >
          <div class="repo-title-col">
            <span class="repo-ix">{String(index + 1).padStart(2, "0")}</span>
            <div class="repo-title-wrap">
              <h4>{t(p.titleKey)}</h4>
              <p class="repo-tags">{p.tags.join(" · ")}</p>
            </div>
          </div>

          <div class="repo-desc-col">
            <p>{t(p.descKey)}</p>
            <a
              class="repo-link"
              href={p.github || p.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor={p.github?"GitHub":"Web"}
            >
              <Icon name={p.github?"simple-icons:github":"lucide:globe"} />
              <span class="hover-ul">
                {p.github?(es?"Explorar repositorio":"Explore repository"):(es?"Visitar proyecto":"Visit project")}
              </span>
              <Icon name="lucide:arrow-up-right" class="repo-arrow" />
            </a>
          </div>
        </article>
      ))}

      <div class="repo-stage" data-archive-stage aria-hidden="true">
        <div class="repo-stage-frame">
          {archiveProjects.map((p, index) => (
            <img
              data-archive-preview
              data-active={index === 0 ? "" : undefined}
              src={cover(p)}
              alt=""
              width="320"
              height="200"
              loading="lazy"
              decoding="async"
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }

  .bento-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(66, 153, 225, 0.2);
    background: linear-gradient(
      135deg,
      rgba(22, 29, 54, 0.38) 0%,
      rgba(11, 16, 28, 0.48) 100%
    );
    backdrop-filter: blur(12px) saturate(135%);
    -webkit-backdrop-filter: blur(12px) saturate(135%);
    transition:
      border-color 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bento-card:hover,
  .bento-card:focus-within {
    border-color: rgba(74, 168, 255, 0.42);
    background: linear-gradient(
      135deg,
      rgba(22, 31, 58, 0.46) 0%,
      rgba(11, 17, 30, 0.56) 100%
    );
    transform: translateY(-2px);
  }

  .bento-flagship {
    grid-column: span 6;
  }

  .bento-wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  }

  .bento-media {
    position: relative;
    display: block;
    overflow: hidden;
    background: rgba(4, 10, 22, 0.45);
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid rgba(148, 204, 255, 0.14);
  }

  .bento-wide .bento-media {
    aspect-ratio: auto;
    height: 100%;
    min-height: 260px;
    border-bottom: 0;
    border-right: 1px solid rgba(148, 204, 255, 0.14);
  }

  .bento-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 58%,
      rgba(5, 12, 25, 0.42) 100%
    );
    pointer-events: none;
  }

  .bento-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover .bento-media img,
  .bento-card:focus-within .bento-media img {
    transform: scale(1.035);
  }

  .bento-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px 26px 26px;
    position: relative;
    z-index: 1;
  }

  .bento-stack {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ice);
    letter-spacing: 0.01em;
    margin-bottom: 8px;
  }

  .bento-body h3 {
    font-size: clamp(22px, 1.85vw, 27px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.024em;
    color: #f4f9ff;
    text-wrap: balance;
  }

  .bento-desc {
    margin-top: 10px;
    font-size: 14.5px;
    line-height: 1.64;
    color: #b7cae0;
    max-width: 58ch;
  }

  .bento-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid rgba(148, 198, 255, 0.11);
  }

  .bento-primary,
  .bento-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    transition:
      color 0.22s ease,
      background-color 0.24s ease,
      border-color 0.24s ease;
  }

  .bento-primary {
    padding: 8px 14px;
    border-radius: 999px;
    color: #eef7ff;
    background: rgba(132, 198, 255, 0.14);
    border: 1px solid rgba(154, 212, 255, 0.32);
  }

  .bento-primary svg {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-primary:hover,
  .bento-primary:focus-visible {
    background: var(--ice);
    border-color: var(--ice);
    color: #051226;
  }

  .bento-primary:hover svg {
    transform: translate(2px, -2px);
  }

  .bento-link {
    color: #bdd9f4;
  }

  .bento-link:hover,
  .bento-link:focus-visible {
    color: #ffffff;
  }

  .bento-actions svg {
    width: 15px;
    height: 15px;
  }

  /* ---- Illuminated Full-Bleed Repository Archive (Argent-inspired, Orbital Blue) ---- */
  .repo-archive {
    margin-top: clamp(54px, 6vw, 84px);
  }

  .repo-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .repo-head h3 {
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    letter-spacing: -0.022em;
    color: #e8f3ff;
  }

  .repo-count {
    font: 500 13px var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--ice);
    letter-spacing: 0.08em;
  }

  .repo-th,
  .repo-row {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.25fr) 220px;
    gap: 28px;
    align-items: center;
  }

  .repo-th {
    padding: 13px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8fb1d4;
  }

  .repo-list {
    position: relative;
  }

  .repo-row {
    position: relative;
    padding: clamp(24px, 3vw, 34px) 0;
    border-bottom: 1px solid var(--line);
  }

  .repo-row::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 50vw);
    right: calc(50% - 50vw);
    background: linear-gradient(
      90deg,
      rgba(12, 26, 52, 0.56) 0%,
      rgba(18, 40, 78, 0.44) 55%,
      rgba(10, 22, 44, 0.56) 100%
    );
    border-block: 1px solid rgba(114, 196, 255, 0.14);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.42s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .repo-row > * {
    position: relative;
    z-index: 1;
    opacity: 0.58;
    transition:
      opacity 0.42s cubic-bezier(0.65, 0, 0.35, 1),
      transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .repo-row[data-active]::before,
  .repo-row[data-active] > *,
  .repo-row:focus-within::before,
  .repo-row:focus-within > * {
    opacity: 1;
  }

  .repo-title-col {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    min-width: 0;
  }

  .repo-row[data-active] .repo-title-col {
    transform: translateX(6px);
  }

  .repo-ix {
    flex: none;
    font: 500 12.5px var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--ice);
    padding-top: 6px;
    letter-spacing: 0.06em;
  }

  .repo-title-wrap {
    min-width: 0;
  }

  .repo-title-wrap h4 {
    margin: 0;
    font-family: var(--title);
    font-size: clamp(21px, 2.2vw, 30px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.024em;
    color: #f4f9ff;
  }

  .repo-tags {
    margin-top: 6px;
    font-size: 12.5px;
    font-weight: 500;
    color: #93c4f2;
  }

  .repo-desc-col {
    position: static;
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .repo-desc-col p {
    position: relative;
    z-index: 1;
    font-size: 14.5px;
    line-height: 1.58;
    color: #c2d6ec;
    max-width: 52ch;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    font-size: 13.5px;
    font-weight: 500;
    color: #e4f2ff;
  }

  .repo-link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .repo-link svg {
    width: 14px;
    height: 14px;
    color: var(--ice);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .repo-row:hover .repo-arrow,
  .repo-row:focus-within .repo-arrow {
    transform: translate(2px, -2px);
  }

  /* Gliding floating visual preview tracking the active row */
  .repo-stage {
    position: absolute;
    right: 0;
    top: 0;
    width: 214px;
    height: 134px;
    z-index: 2;
    pointer-events: none;
    transform: translate3d(0, calc(var(--oy, 86px) - 50%), 0);
    transition: transform 0.52s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .repo-stage-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(124, 198, 255, 0.32);
    background: rgba(5, 11, 24, 0.92);
    box-shadow: 0 18px 34px -14px rgba(1, 5, 16, 0.85);
  }

  .repo-stage-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 0.44s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.52s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .repo-stage-frame img[data-active] {
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .bento-flagship {
      grid-column: span 1;
    }

    .bento-wide {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }

    .repo-th,
    .repo-row {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 20px;
    }

    .repo-th span:last-child,
    .repo-stage {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .bento-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .bento-wide {
      display: flex;
      flex-direction: column;
    }

    .bento-wide .bento-media {
      aspect-ratio: 16 / 10;
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid rgba(148, 204, 255, 0.14);
    }

    .bento-body {
      padding: 18px 20px 20px;
    }

    .repo-th {
      display: none;
    }

    .repo-row {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 20px 0;
    }

    .repo-row[data-active] .repo-title-col {
      transform: none;
    }
  }
</style>
