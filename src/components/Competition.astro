---
import { Icon } from "astro-icon/components";
import { base, type Language } from "../i18n";
interface Props {
  lang: Language;
}
const es = Astro.props.lang === "es";
const previousEditions = [
  {
    edition: "IV",
    date: es ? "Junio de 2026" : "June 2026",
    result: es ? "4.º lugar por equipos" : "4th place as a team",
  },
  {
    edition: "III",
    date: es ? "Noviembre de 2025" : "November 2025",
    result: es ? "800 puntos individuales" : "800 individual points",
  },
  {
    edition: "II",
    date: es ? "Junio de 2025" : "June 2025",
    result: es ? "6.º lugar por equipos" : "6th place as a team",
  },
];
---

<section
  class="section wrap competition"
  id="competencias"
  aria-labelledby="competition-title"
>
  <h2 id="competition-title">{es ? "Competencias" : "Competitions"}</h2>
  <article class="result">
    <div class="organizers">
      <img width="112" src={base + "media/sek.webp"} alt="SEK" loading="lazy" />
      <img
        width="88"
        src={base + "media/dreamlab.webp"}
        alt="Dreamlab Technologies"
        loading="lazy"
      />
    </div>
    <div class="result-copy">
      <h3>CTF SEK/UDP · {es ? "V edición" : "5th edition"}</h3>
      <p>
        {es
          ? "Universidad Diego Portales · Equipo INSIDE"
          : "Universidad Diego Portales · Team INSIDE"}
      </p>
      <p>
        {es
          ? "Como capitán de INSIDE, competí bajo el alias Forcex y sumé 1.500 de nuestros 4.235 puntos."
          : "I captained INSIDE as Forcex and contributed 1,500 of our 4,235 points."}
      </p>
      <a
        href="https://ctfd-udp.my-ctf.com/scoreboard"
        target="_blank"
        rel="noopener"
      >
        {es ? "Ver marcador" : "View scoreboard"}{" "}
        <Icon name="lucide:arrow-up-right" />
      </a>
    </div>
    <div class="place">
      <strong>{es ? "3.er lugar" : "3rd place"}</strong>
    </div>
  </article>
  <article class="result">
    <div class="organizers">
      <img
        class="xtreme-logo"
        src={base + "media/ieeextreme.png"}
        width="511"
        height="246"
        alt="IEEEXtreme Programming Competition"
        loading="lazy"
      />
    </div>
    <div class="result-copy">
      <h3>IEEEXtreme 19.0</h3>
      <p>
        {es
          ? "Equipo FlagRebels · Octubre de 2025"
          : "Team FlagRebels · October 2025"}
      </p>
      <p>
        {es
          ? "Competencia de programación de 24 horas. Terminamos en el puesto 924 de la clasificación mundial."
          : "A 24-hour programming competition. We finished 924th in the worldwide ranking."}
      </p>
      <a
        href="https://ieeextreme.org/ieeextreme-19-0-ranking/"
        target="_blank"
        rel="noopener"
      >
        {es ? "Ver clasificación" : "View rankings"}{" "}
        <Icon name="lucide:arrow-up-right" />
      </a>
    </div>
    <div class="place">
      <strong>{es ? "6.º lugar" : "6th place"}</strong>
      <span>{es ? "en Chile" : "in Chile"}</span>
    </div>
  </article>
  <section class="history" aria-labelledby="past-ctf-title">
    <h3 id="past-ctf-title">
      {es ? "Ediciones anteriores del CTF" : "Previous CTF editions"}
    </h3>
    <ul>
      {previousEditions.map(({ edition, date, result }) => (
        <li>
          <span class="edition">
            {es ? "Edición" : "Edition"} {edition}
          </span>
          <span class="edition-date">{date}</span>
          <strong>{result}</strong>
        </li>
      ))}
    </ul>
  </section>
</section>
<style>
  .competition h2 {
    margin-bottom: 26px;
  }
  .result {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    border-top: 1px solid var(--line);
    padding-block: 27px;
  }
  .organizers {
    display: grid;
    align-items: center;
    justify-items: start;
    gap: 10px;
  }
  .organizers img {
    max-width: 100%;
    height: auto;
    max-height: 65px;
    object-fit: contain;
    object-position: left center;
  }
  .organizers .xtreme-logo {
    width: 132px;
  }
  .result h3 {
    font-size: clamp(21px, 2vw, 26px);
    font-weight: 550;
    letter-spacing: -0.025em;
  }
  .result p {
    max-width: 68ch;
    color: var(--dim);
    margin-top: 4px;
  }
  .result a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 12px;
    color: var(--ice);
  }
  .result a:hover {
    text-decoration: underline;
  }
  .place {
    display: grid;
    justify-items: end;
    line-height: 1.12;
  }
  .place strong {
    font-size: clamp(28px, 3.3vw, 46px);
    color: var(--ice);
    font-weight: 650;
    letter-spacing: -0.035em;
  }
  .place span {
    color: var(--dim);
    font-size: 14px;
    margin-top: 5px;
  }
  .history {
    display: grid;
    grid-template-columns: minmax(190px, 0.85fr) minmax(0, 2fr);
    gap: 24px;
    border-top: 1px solid var(--line);
    padding-top: 26px;
  }
  .history h3 {
    font-size: 18px;
    font-weight: 550;
  }
  .history ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .history li {
    display: grid;
    grid-template-columns: minmax(5em, 0.65fr) 1fr minmax(0, 1.35fr);
    align-items: baseline;
    gap: 12px;
    padding-block: 9px;
  }
  .history li:first-child {
    padding-top: 0;
  }
  .history li + li {
    border-top: 1px solid var(--line);
  }
  .history .edition-date {
    color: var(--dim);
    font-size: 14px;
  }
  .history strong {
    text-align: right;
    font-weight: 550;
  }
  @media (max-width: 760px) {
    .result {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 16px;
    }
    .organizers {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .organizers img {
      max-width: min(20vw, 88px);
    }
    .organizers .xtreme-logo {
      width: 115px;
      max-width: 100%;
    }
    .result-copy {
      grid-column: 1/-1;
      grid-row: 2;
    }
    .place {
      grid-row: 1;
      grid-column: 2;
    }
    .history {
      display: block;
    }
    .history h3 {
      margin-bottom: 18px;
    }
  }
  @media (max-width: 500px) {
    .history li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 12px;
    }
    .history .edition-date {
      grid-column: 1;
      grid-row: 2;
      font-size: 13px;
    }
    .history strong {
      grid-row: 1/3;
      grid-column: 2;
      align-self: center;
      font-size: 14px;
    }
  }
</style>
