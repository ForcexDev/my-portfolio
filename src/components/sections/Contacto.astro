---
/**
 * Contacto: la barra de cristal flotante del sitio viejo más el formulario.
 *
 * El diseño es el de antes, copiado de css/components.css:600-700 (la barra,
 * los círculos de 50px y su tooltip) y :729-795 (el formulario). Dos cambios
 * de fondo, ninguno visible:
 *   - los enlaces salen de `redes` en src/data/site.ts, no escritos a mano en
 *     inglés en cuatro HTML distintos,
 *   - el envío ya no carga el SDK de EmailJS desde un CDN. Es un `fetch` a su
 *     API, que es literalmente lo que hacía el SDK: 10 kB y una petición menos.
 *
 * La `publicKey` va en el HTML a propósito: es pública por diseño, el SDK
 * también la dejaba ahí. Si algún día entra spam, se activa el captcha en el
 * panel de EmailJS.
 */
import { Icon } from 'astro-icon/components';
import Seccion from '@/components/layout/Seccion.astro';
import { useTraducciones, type Idioma } from '@/i18n';
import { site, redes, emailjs } from '@/data/site';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = useTraducciones(idioma);
---

<Seccion id="contacto" titulo={t('contacto.titulo')} subtitulo={t('contacto.subtitulo')}>
  <div class="barra reveal">
    <div class="iconos">
      {/* El correo no estaba en la barra vieja (vivía suelto en el HTML); aquí
          es un círculo más para no perderlo de vista. */}
      <a href={`mailto:${site.email}`} class="social" aria-label="Email">
        <Icon name="lucide:mail" />
        <span class="tooltip">Email</span>
      </a>

      {
        redes.map((red) => (
          <a href={red.url} class="social" target="_blank" rel="noopener noreferrer" aria-label={red.nombre}>
            <Icon name={red.icono} />
            <span class="tooltip">{red.nombre}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="caja-form reveal">
    <h3 class="form-titulo">{t('contacto.formTitulo')}</h3>

    <form
      class="formulario"
      data-service={emailjs.serviceId}
      data-template={emailjs.templateId}
      data-clave={emailjs.publicKey}
      data-enviando={t('contacto.enviando')}
      data-ok={t('contacto.ok')}
      data-error={t('contacto.error')}
    >
      <div class="campo">
        <label for="c-nombre">{t('contacto.nombre')}</label>
        <input
          id="c-nombre"
          type="text"
          name="from_name"
          required
          placeholder={t('contacto.nombrePh')}
          autocomplete="name"
        />
      </div>

      <div class="campo">
        <label for="c-email">{t('contacto.email')}</label>
        <input
          id="c-email"
          type="email"
          name="from_email"
          required
          placeholder={t('contacto.emailPh')}
          autocomplete="email"
        />
      </div>

      <div class="campo">
        <label for="c-asunto">{t('contacto.asunto')}</label>
        <input id="c-asunto" type="text" name="subject" required placeholder={t('contacto.asuntoPh')} />
      </div>

      <div class="campo">
        <label for="c-mensaje">{t('contacto.mensaje')}</label>
        <textarea id="c-mensaje" name="message" rows="5" required placeholder={t('contacto.mensajePh')}></textarea>
      </div>

      {/* Trampa para robots: nadie que vea la página puede rellenarlo. */}
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="trampa" aria-hidden="true" />

      <button type="submit" class="btn enviar">
        <span class="enviar__texto">{t('contacto.enviar')}</span>
        <Icon name="lucide:send" />
      </button>

      <p class="estado" role="status" aria-live="polite"></p>
    </form>
  </div>
</Seccion>

<script>
  const formulario = document.querySelector<HTMLFormElement>('.formulario');

  formulario?.addEventListener('submit', async (evento) => {
    evento.preventDefault();

    const datos = new FormData(formulario);
    const estado = formulario.querySelector<HTMLElement>('.estado')!;
    const boton = formulario.querySelector<HTMLButtonElement>('.enviar')!;
    const texto = boton.querySelector<HTMLElement>('.enviar__texto')!;
    const etiquetaEnviar = texto.textContent;
    const d = formulario.dataset;

    // El bot rellenó la trampa: se le dice que todo bien y no se envía nada.
    if (datos.get('website')) {
      estado.textContent = d.ok!;
      estado.className = 'estado estado--ok';
      formulario.reset();
      return;
    }

    boton.disabled = true;
    texto.textContent = d.enviando!;
    estado.textContent = '';
    estado.className = 'estado';

    try {
      // Esto es exactamente lo que hace el SDK de EmailJS por dentro.
      const respuesta = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          service_id: d.service,
          template_id: d.template,
          user_id: d.clave,
          template_params: {
            from_name: datos.get('from_name'),
            from_email: datos.get('from_email'),
            subject: datos.get('subject'),
            message: datos.get('message'),
            to_name: 'Ezequiel',
          },
        }),
      });
      if (!respuesta.ok) throw new Error(await respuesta.text());

      estado.textContent = d.ok!;
      estado.className = 'estado estado--ok';
      formulario.reset();
    } catch (error) {
      console.error('EmailJS:', error);
      estado.textContent = d.error!;
      estado.className = 'estado estado--error';
    } finally {
      boton.disabled = false;
      texto.textContent = etiquetaEnviar;
    }
  });
</script>

<style>
  /* --- La barra flotante (css/components.css:600-621) --- */
  .barra {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: fit-content;
    margin: 0 auto;
    padding: 1rem 2rem;
    border: 1px solid rgb(66 153 225 / 0.15);
    border-radius: 50px;
    background: rgb(255 255 255 / 0.03);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.3);
  }
  .iconos {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  /* Círculo de 50 px, plateado, que crece y se ilumina al pasar el ratón
     (css/components.css:624-660). */
  .social {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border: 1px solid rgb(255 255 255 / 0.05);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.05);
    color: var(--color-silver);
    font-size: 1.4rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .social:hover,
  .social:focus-visible {
    border-color: var(--color-nebula);
    background: rgb(66 153 225 / 0.15);
    color: var(--color-stellar);
    transform: scale(1.15) translateY(-3px);
    box-shadow: 0 5px 15px rgb(66 153 225 / 0.2);
  }

  .tooltip {
    position: absolute;
    bottom: 115%;
    left: 50%;
    padding: 0.3rem 0.6rem;
    border: 1px solid rgb(66 153 225 / 0.2);
    border-radius: 4px;
    background: var(--color-void);
    color: var(--color-nebula);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(10px);
    transition: all 0.2s ease;
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.5);
  }
  .social:hover .tooltip,
  .social:focus-visible .tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* --- El formulario (css/components.css:729-795) --- */
  .caja-form {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(66 153 225 / 0.15);
    text-align: center;
  }
  .form-titulo {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-stellar);
    text-shadow: 0 0 15px rgb(66 153 225 / 0.4);
  }

  .formulario {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }
  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
  }
  label {
    color: var(--color-dim);
    font-size: 0.9rem;
    font-weight: 500;
  }
  input,
  textarea {
    padding: 1rem 1.2rem;
    border: 1px solid rgb(66 153 225 / 0.2);
    border-radius: 12px;
    background: rgb(26 31 58 / 0.6);
    color: var(--color-stellar);
    font-family: inherit;
    font-size: 1rem;
    backdrop-filter: blur(10px);
    transition:
      border-color 0.3s var(--ease-space),
      box-shadow 0.3s var(--ease-space);
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-nebula);
    box-shadow: 0 0 20px rgb(66 153 225 / 0.15);
  }
  input::placeholder,
  textarea::placeholder {
    color: rgb(203 213 225 / 0.5);
  }
  textarea {
    min-height: 120px;
    resize: vertical;
  }

  /* Fuera de pantalla y no `display:none`: algunos bots rellenan solo lo
     visible en el DOM y este tiene que parecer un campo normal. */
  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* La pinta la pone `.btn` en cosmic.css; el viejo iba a todo el ancho. */
  .enviar {
    width: 100%;
    justify-content: center;
    margin-top: 0.5rem;
    padding: 1rem 2rem;
    font-size: 1rem;
  }
  .enviar:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  /* Alto reservado desde el principio: si la caja apareciera solo al enviar,
     la página daría un salto. */
  .estado {
    margin: 1rem 0 0;
    min-height: 3.5rem;
    padding: 1rem;
    border-radius: 12px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .estado--ok {
    border: 1px solid rgb(72 187 120 / 0.2);
    background: rgb(72 187 120 / 0.1);
    color: #68d391;
  }
  .estado--error {
    border: 1px solid rgb(245 101 101 / 0.2);
    background: rgb(245 101 101 / 0.1);
    color: #fc8181;
  }

  @media (max-width: 768px) {
    .barra {
      max-width: none;
      padding: 1.5rem;
      border-radius: 20px;
    }
    .iconos {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      width: 100%;
    }
    .social {
      width: 60px;
      height: 60px;
      font-size: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social,
    .tooltip {
      transition: none;
    }
    .social:hover,
    .social:focus-visible {
      transform: none;
    }
    .tooltip,
    .social:hover .tooltip {
      transform: translateX(-50%);
    }
  }
</style>
