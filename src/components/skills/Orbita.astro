---
/**
 * El sistema orbital de habilidades, en Three.js.
 *
 * Reparto de trabajo, que es lo que hace que esto no sea ni un lienzo mudo ni
 * cinco circunferencias planas de CSS:
 *
 *   WebGL  → el planeta (esfera con su terminador, rejilla de meridianos y
 *            atmósfera de fresnel) y las líneas de órbita, con inclinaciones
 *            distintas para que se crucen como un sistema de verdad.
 *   DOM    → los satélites. Siguen siendo `<button>` con su icono a color: se
 *            tabulan, se leen con lector de pantalla y llevan a su sitio. Cada
 *            fotograma se les calcula la posición proyectando su nodo 3D a
 *            pantalla, y el tamaño sale de la distancia a cámara.
 *
 * La oclusión es un corte rayo-esfera exacto (no un truco de z): un satélite
 * que pasa por detrás del planeta se apaga y deja de aceptar clics, que es lo
 * que vende la profundidad.
 *
 * Three entra por `import()` y solo cuando el navegador está ocioso — igual que
 * en SpaceCanvas. Si no hay WebGL o falla la descarga, el bloque no aparece y
 * queda la lista de abajo, que dice exactamente lo mismo y es la que sirve para
 * buscar. Por eso `.sistema` nace oculto y solo se muestra si todo montó.
 */
import { Icon } from 'astro-icon/components';
import { skillGroups } from '@/data/skills';
import { useTraducciones, type Idioma } from '@/i18n';
import { site } from '@/data/site';
import { slugSkill } from '@/utils/skills';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = useTraducciones(idioma);

// El grupo más pequeño al anillo de dentro, que es el que menos sitio tiene.
// Los radios, inclinaciones y velocidades están en el script, en ANILLOS.
const anillos = [...skillGroups].sort((a, b) => a.items.length - b.items.length);
---

<div class="sistema" aria-hidden="true">
  <div class="escena">
    <canvas class="lienzo"></canvas>

    <div class="capa">
      {
        anillos.map((grupo, i) =>
          grupo.items.map((skill, j) => (
            <button
              type="button"
              class="satelite"
              data-anillo={i}
              data-indice={j}
              data-total={grupo.items.length}
              data-nombre={skill.nombre}
              data-destino={`skill-${slugSkill(skill.nombre)}`}
              title={skill.nombre}
            >
              <Icon name={skill.icono} class="satelite__ico" />
              <span class="sr-only">{skill.nombre}</span>
            </button>
          )),
        )
      }
    </div>

    <p class="eco">{site.alias.toLowerCase()}</p>
  </div>

  <p class="pista">{t('skills.orbitaAyuda')}</p>
</div>

<script>
  const sistema = document.querySelector<HTMLElement>('.sistema');
  const escena = sistema?.querySelector<HTMLElement>('.escena');
  const lienzo = sistema?.querySelector<HTMLCanvasElement>('.lienzo');

  if (sistema && escena && lienzo) {
    const arrancar = () => import('three').then(montar).catch(() => {});
    if ('requestIdleCallback' in window) requestIdleCallback(arrancar, { timeout: 2500 });
    else addEventListener('load', () => setTimeout(arrancar, 300));
  }

  async function montar(THREE: typeof import('three')) {
    const R = 1.5; // radio del planeta: todo lo demás se mide en unidades suyas
    const DIST = 17.2; // distancia de la cámara al centro, y escala 1 de los iconos
    const ELEV = 0.42; // 24° de elevación: suficiente para ver los planos cruzarse

    // Un anillo por grupo. `incl` inclina el plano y `nodo` lo gira, para que
    // no sean cinco círculos concéntricos; `v` en vueltas por segundo, con
    // signo alterno para que dos vecinos no se lean como un bloque.
    const ANILLOS = [
      { r: 2.6, incl: 0.0, nodo: 0.0, v: 0.038, tono: 0x00f3ff },
      { r: 3.2, incl: 0.28, nodo: 1.1, v: -0.031, tono: 0x4299e1 },
      { r: 3.85, incl: -0.22, nodo: 2.2, v: 0.025, tono: 0x9f7aea },
      { r: 4.5, incl: 0.3, nodo: 0.6, v: -0.021, tono: 0xbc13fe },
      { r: 5.2, incl: -0.26, nodo: 1.7, v: 0.017, tono: 0x6b46c1 },
    ];

    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const render = new THREE.WebGLRenderer({ canvas: lienzo!, alpha: true, antialias: true });
    render.setPixelRatio(Math.min(devicePixelRatio, 2));

    const mundo3d = new THREE.Scene();
    const camara = new THREE.PerspectiveCamera(26, 1.6, 0.5, 60);
    camara.position.set(0, DIST * Math.sin(ELEV), DIST * Math.cos(ELEV));
    camara.lookAt(0, 0, 0);

    // Todo cuelga de aquí: arrastrar gira esto, no la cámara.
    const conjunto = new THREE.Group();
    mundo3d.add(conjunto);

    /* --- el planeta --- */
    const nucleo = new THREE.Mesh(
      new THREE.SphereGeometry(R, 64, 48),
      new THREE.ShaderMaterial({
        uniforms: { uLuz: { value: new THREE.Vector3(-0.62, 0.4, 0.42).normalize() } },
        vertexShader: `
          varying vec3 vN; varying vec3 vP;
          void main() {
            vN = normalize(normalMatrix * normal);
            vec4 mv = modelViewMatrix * vec4(position, 1.0);
            vP = mv.xyz;
            gl_Position = projectionMatrix * mv;
          }`,
        // Día azul, noche casi negra y un filo de atmósfera en el borde: es el
        // terminador lo que hace que se lea como esfera y no como círculo.
        fragmentShader: `
          uniform vec3 uLuz; varying vec3 vN; varying vec3 vP;
          void main() {
            vec3 n = normalize(vN);
            float dia = clamp(dot(n, normalize(uLuz)), 0.0, 1.0);
            vec3 base = mix(vec3(0.006, 0.011, 0.030), vec3(0.11, 0.35, 0.63), pow(dia, 1.3));
            float filo = pow(1.0 - max(dot(n, normalize(-vP)), 0.0), 3.0);
            gl_FragColor = vec4(base + filo * vec3(0.0, 0.42, 0.62), 1.0);
          }`,
      }),
    );
    conjunto.add(nucleo);

    // Rejilla de meridianos y paralelos, dibujada a mano: el `wireframe` de una
    // esfera de Three sale triangulado y con diagonales, que es otra cosa.
    const tinta = new THREE.LineBasicMaterial({ color: 0x4299e1, transparent: true, opacity: 0.17 });
    const curva = (puntos: InstanceType<typeof THREE.Vector3>[], cerrada: boolean) => {
      const geo = new THREE.BufferGeometry().setFromPoints(puntos);
      nucleo.add(cerrada ? new THREE.LineLoop(geo, tinta) : new THREE.Line(geo, tinta));
    };
    const r = R * 1.003; // justo por fuera, si no la esfera se come la línea
    for (let m = 0; m < 12; m++) {
      const a = (m / 12) * Math.PI * 2;
      curva(
        Array.from({ length: 49 }, (_, i) => {
          const f = (i / 48) * Math.PI - Math.PI / 2;
          return new THREE.Vector3(Math.cos(f) * Math.cos(a) * r, Math.sin(f) * r, Math.cos(f) * Math.sin(a) * r);
        }),
        false,
      );
    }
    for (let p = 1; p < 8; p++) {
      const lat = (p / 8) * Math.PI - Math.PI / 2;
      const rr = Math.cos(lat) * r;
      const y = Math.sin(lat) * r;
      curva(
        Array.from({ length: 64 }, (_, i) => {
          const a = (i / 64) * Math.PI * 2;
          return new THREE.Vector3(Math.cos(a) * rr, y, Math.sin(a) * rr);
        }),
        true,
      );
    }

    // Atmósfera: una cáscara vista por dentro que solo se enciende en el borde.
    conjunto.add(
      new THREE.Mesh(
        new THREE.SphereGeometry(R * 1.12, 48, 32),
        new THREE.ShaderMaterial({
          transparent: true,
          depthWrite: false,
          side: THREE.BackSide,
          blending: THREE.AdditiveBlending,
          uniforms: { uColor: { value: new THREE.Color(0x4299e1) } },
          vertexShader: `
            varying vec3 vN; varying vec3 vP;
            void main() {
              vN = normalize(normalMatrix * normal);
              vec4 mv = modelViewMatrix * vec4(position, 1.0);
              vP = mv.xyz;
              gl_Position = projectionMatrix * mv;
            }`,
          fragmentShader: `
            uniform vec3 uColor; varying vec3 vN; varying vec3 vP;
            void main() {
              float f = pow(1.0 - abs(dot(normalize(vN), normalize(-vP))), 4.5);
              gl_FragColor = vec4(uColor, f * 0.95);
            }`,
        }),
      ),
    );

    /* --- los anillos y sus satélites --- */
    const botones = [...escena!.querySelectorAll<HTMLElement>('.satelite')];
    const satelites = botones.map((el) => {
      const { anillo, indice, total } = el.dataset;
      const cfg = ANILLOS[Number(anillo)]!;
      const a = (Number(indice) / Number(total)) * Math.PI * 2;
      const nodo = new THREE.Object3D();
      nodo.position.set(Math.cos(a) * cfg.r, 0, Math.sin(a) * cfg.r);
      el.style.setProperty('--tono', '#' + cfg.tono.toString(16).padStart(6, '0'));
      return { el, nodo, cfg };
    });

    const giros = ANILLOS.map((cfg) => {
      const plano = new THREE.Object3D();
      plano.rotation.order = 'YXZ';
      plano.rotation.y = cfg.nodo;
      plano.rotation.x = cfg.incl;
      conjunto.add(plano);

      plano.add(
        new THREE.LineLoop(
          new THREE.BufferGeometry().setFromPoints(
            Array.from({ length: 128 }, (_, i) => {
              const a = (i / 128) * Math.PI * 2;
              return new THREE.Vector3(Math.cos(a) * cfg.r, 0, Math.sin(a) * cfg.r);
            }),
          ),
          new THREE.LineBasicMaterial({ color: cfg.tono, transparent: true, opacity: 0.22 }),
        ),
      );

      const giro = new THREE.Object3D();
      plano.add(giro);
      return giro;
    });
    satelites.forEach(({ nodo, cfg }) => giros[ANILLOS.indexOf(cfg)]!.add(nodo));

    /* --- tamaño --- */
    let ancho = 0;
    let alto = 0;
    const medir = () => {
      ancho = escena!.clientWidth;
      alto = escena!.clientHeight;
      camara.aspect = ancho / alto;
      camara.updateProjectionMatrix();
      render.setSize(ancho, alto, false);
    };
    medir();
    new ResizeObserver(medir).observe(escena!);

    /* --- ratón: parar, mirar y arrastrar --- */
    const eco = escena!.querySelector<HTMLElement>('.eco')!;
    const reposo = eco.textContent!;
    let parado = false;
    let arrastrando = false;
    let ultimoX = 0;
    let ultimoY = 0;

    escena!.addEventListener('pointerover', (e) => {
      const sat = (e.target as HTMLElement).closest<HTMLElement>('.satelite');
      if (!sat) return;
      eco.textContent = sat.dataset.nombre!;
      parado = true; // apuntar a algo que se mueve es una tortura
    });
    escena!.addEventListener('pointerout', (e) => {
      if ((e.target as HTMLElement).closest('.satelite')) parado = arrastrando;
    });
    escena!.addEventListener('pointerleave', () => {
      eco.textContent = reposo;
      parado = arrastrando;
    });

    escena!.addEventListener('pointerdown', (e) => {
      arrastrando = true;
      parado = true;
      ultimoX = e.clientX;
      ultimoY = e.clientY;
      escena!.setPointerCapture(e.pointerId);
    });
    escena!.addEventListener('pointermove', (e) => {
      if (!arrastrando) return;
      conjunto.rotation.y += (e.clientX - ultimoX) * 0.006;
      // Sin pasarse: más de esto y se ve el sistema de canto.
      conjunto.rotation.x = Math.max(-0.5, Math.min(0.45, conjunto.rotation.x + (e.clientY - ultimoY) * 0.004));
      ultimoX = e.clientX;
      ultimoY = e.clientY;
    });
    const soltar = (e: PointerEvent) => {
      if (!arrastrando) return;
      arrastrando = false;
      parado = false;
      escena!.releasePointerCapture(e.pointerId);
    };
    escena!.addEventListener('pointerup', soltar);
    escena!.addEventListener('pointercancel', soltar);

    // Clic: baja a la baldosa de esa tecnología y la enciende, para que el
    // juguete sirva de índice y no solo de adorno.
    escena!.addEventListener('click', (e) => {
      const sat = (e.target as HTMLElement).closest<HTMLElement>('.satelite');
      const destino = sat && document.getElementById(sat.dataset.destino!);
      if (!destino) return;

      destino.scrollIntoView({ block: 'center', behavior: 'smooth' });
      destino.classList.remove('es-destino');
      void destino.offsetWidth; // reinicia la animación si se pulsa dos veces
      destino.classList.add('es-destino');
      destino.addEventListener('animationend', () => destino.classList.remove('es-destino'), { once: true });
    });

    /* --- bucle --- */
    let ultimo = performance.now();
    const camPos = new THREE.Vector3();
    const pos = new THREE.Vector3();
    const haz = new THREE.Vector3();
    const alCentro = new THREE.Vector3();
    let visible = true;

    // Mientras la sección no esté en pantalla no se dibuja nada.
    new IntersectionObserver(([e]) => {
      visible = e!.isIntersecting;
      if (visible) {
        ultimo = performance.now(); // tira el tiempo que estuvo parado
        requestAnimationFrame(bucle);
      }
    }).observe(sistema!);

    function bucle() {
      if (!visible) return;
      requestAnimationFrame(bucle);

      const ahora = performance.now();
      const dt = Math.min((ahora - ultimo) / 1000, 0.05); // pestaña de fondo: sin saltos
      ultimo = ahora;
      if (!parado && !quieto) {
        nucleo.rotation.y += dt * 0.06;
        giros.forEach((giro, i) => (giro.rotation.y += dt * ANILLOS[i]!.v * Math.PI * 2));
      }

      render.render(mundo3d, camara);
      camara.getWorldPosition(camPos);

      for (const { el, nodo } of satelites) {
        nodo.getWorldPosition(pos);

        // Corte rayo-esfera: ¿pasa el planeta entre la cámara y el satélite?
        haz.subVectors(pos, camPos);
        const L = haz.length();
        haz.divideScalar(L);
        alCentro.copy(camPos).negate();
        const proy = alCentro.dot(haz);
        const perp = Math.sqrt(Math.max(0, alCentro.lengthSq() - proy * proy));
        const tapado = proy > 0 && proy < L && perp < R * 1.02;

        pos.project(camara);
        const x = (pos.x * 0.5 + 0.5) * ancho;
        const y = (-pos.y * 0.5 + 0.5) * alto;
        el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${Math.pow(DIST / L, 0.6).toFixed(3)})`;
        // Los de delante tapan a los de detrás, y los de detrás se apagan.
        el.style.zIndex = String(Math.round(400 - L * 20));
        el.style.opacity = tapado ? '0.07' : (1 - 0.5 * Math.min(1, Math.max(0, (L - DIST + 5.5) / 11))).toFixed(2);
        el.classList.toggle('es-tapado', tapado);
      }
    }

    sistema!.removeAttribute('aria-hidden');
    sistema!.setAttribute('role', 'group');
    sistema!.classList.add('es-viva');
    bucle();
  }
</script>

<style>
  /* Nace oculto: si Three no monta (sin WebGL, sin red), aquí no hay nada que
     enseñar y la lista de abajo ya cuenta lo mismo. */
  .sistema {
    display: none;
  }
  .sistema.es-viva {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .escena {
    position: relative;
    width: min(100%, 62rem);
    /* La misma proporción que el `aspect` de la cámara: si cambia uno, cambia
       el otro o el sistema deja de caber justo. */
    aspect-ratio: 16 / 10;
    touch-action: none; /* el arrastre gira el sistema, no la página */
    cursor: grab;
  }
  .escena:active {
    cursor: grabbing;
  }

  .lienzo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Los satélites viven aquí encima, pero la capa no intercepta el arrastre:
     solo los propios botones cogen el ratón. */
  .capa {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .satelite {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: -1.25rem;
    padding: 0;
    border: 1px solid rgb(66 153 225 / 0.28);
    border-radius: 50%;
    background: rgb(8 12 26 / 0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    /* Hasta que el bucle le dé su sitio no debe verse en la esquina. */
    opacity: 0;
    cursor: pointer;
    pointer-events: auto;
    transition:
      border-color 0.25s var(--ease-space),
      background 0.25s var(--ease-space),
      box-shadow 0.25s var(--ease-space);
  }
  .satelite:hover,
  .satelite:focus-visible {
    border-color: var(--tono);
    background: rgb(66 153 225 / 0.2);
    box-shadow:
      0 0 18px var(--tono),
      inset 0 0 12px rgb(66 153 225 / 0.3);
    outline: none;
  }
  /* Detrás del planeta: se ve apagado y no se puede pulsar por error. */
  .satelite.es-tapado {
    pointer-events: none;
  }

  .satelite__ico {
    width: 1.45rem;
    height: 1.45rem;
    color: var(--tono);
    filter: drop-shadow(0 2px 5px rgb(0 0 0 / 0.6));
    transition: transform 0.25s var(--ease-spring);
  }
  .satelite:hover .satelite__ico,
  .satelite:focus-visible .satelite__ico {
    transform: scale(1.2);
  }

  /* El nombre de lo que se está señalando, sobre el planeta. */
  .eco {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 500;
    max-width: 40%;
    margin: 0;
    color: var(--color-stellar);
    font-family: var(--font-mono);
    font-size: clamp(0.66rem, 1.4vw, 0.85rem);
    text-align: center;
    text-shadow: 0 0 12px rgb(0 0 17 / 0.95);
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .pista {
    margin: 0;
    color: var(--color-dim);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    opacity: 0.55;
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Por debajo de esto los satélites del anillo interior se pisan. La lista de
     abajo dice lo mismo y ahí sí se lee. */
  @media (max-width: 820px) {
    .sistema.es-viva {
      display: none;
    }
  }
</style>
